SERVER_NAME="example.com"
FPM_POOL="example"
LOG_DIR="/home/example/logs"

ALERT_EMAIL="admin@example.com"
ALERT_FROM="monitor@example.com"
CF_DASH_URL="https://dash.cloudflare.com/<account-id>/<zone-name>"

CF_TOKEN="<cloudflare-api-token>"
CF_ZONE="<cloudflare-zone-id>"

MAX_LINES=240           # 12 hours at 3-min intervals
ALERT_COOLDOWN=1800     # seconds between alerts (30 min)

FPM_MAX=40              # pm.max_children in php-fpm pool config
FPM_WARN_PCT=90         # alert when workers reach this % of FPM_MAX

LOAD_HIGH_THRESHOLD=7.5   # triggers alert + CF Under Attack Mode
LOAD_LOW_THRESHOLD=1.0    # load must stay below this for 10 min to disable CF UAM

FPM_MEM_THRESHOLD_MB=6500   # total php-fpm RSS; alert after 3 consecutive rounds
MEM_AVAIL_THRESHOLD_MB=1000 # system available memory floor
SWAP_THRESHOLD_MB=1500      # swap usage ceiling

TCP_ESTAB_THRESHOLD=300
HTTPD_THRESHOLD=200
MYSQL_THRESHOLD=200
